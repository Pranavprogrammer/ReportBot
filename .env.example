# Email is disabled by default for safe local demos.
REPORTBOT_SEND_EMAIL=false
REPORTBOT_SENDER_EMAIL=
REPORTBOT_SENDER_PASSWORD=
REPORTBOT_RECIPIENT_EMAIL=
REPORTBOT_SMTP_HOST=smtp.gmail.com
REPORTBOT_SMTP_PORT=587

# Scheduler runs every day at 09:00 by default.
REPORTBOT_SCHEDULE_HOUR=9
REPORTBOT_SCHEDULE_MINUTE=0
REPORTBOT_TIMEZONE=Asia/Kolkata
